# Supabase (leave blank in this starter — no live backend is wired up yet).
# See docs/database-schema.md for the schema these will back once connected,
# and docs/architecture/03-security-and-tenancy.md for the tenancy/RLS model
# the schema depends on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle (server/db/*) — use Supabase's
# transaction pooler (Supavisor, port 6543), not the direct connection, so
# it works from serverless functions. Project settings → Database →
# Connection string. Never referenced from client components.
DATABASE_URL=

# AI provider key (Anthropic by default — see docs/AI_AGENT_ARCHITECTURE.md
# and docs/architecture/04-ai-and-agents.md for the provider abstraction
# this backs). Never referenced from client components.
AI_PROVIDER_API_KEY=
