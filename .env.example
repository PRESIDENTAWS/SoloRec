# Supabase — Project Settings → API. The URL and anon key are safe to expose
# to the browser (NEXT_PUBLIC_*); the service role key must never be.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider abstraction (services/ai/*). AI_PROVIDER selects which one
# AVA's matching workflow uses; only that provider's key needs to be set.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Base URL of this deployment — used for auth redirect/callback links
# (password reset, email confirmation).
NEXT_PUBLIC_APP_URL=http://localhost:3000
